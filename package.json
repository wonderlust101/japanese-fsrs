{
	"name": "japanese-fsrs",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"db:types": "{ echo '/* GENERATED FILE - DO NOT EDIT. Source: committed migrations (supabase gen types --local). Regenerate: bun run db:types */'; echo; supabase gen types typescript --local; } > apps/api/src/db/database.types.ts",
		"db:lint": "supabase db lint --level error --fail-on error --schema public"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@eslint-react/eslint-plugin": "^5.8.6",
		"@fsrs-japanese/tsconfig": "workspace:*",
		"@next/eslint-plugin-next": "^16.2.6",
		"@types/bun": "^1.3.0",
		"eslint": "10.2.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"supabase": "2.95.3",
		"typescript": "^5"
	},
	"overrides": {
		"brace-expansion": "^5.0.6",
		"postcss": "^8.5.14",
		"qs": "^6.15.2",
		"ws": "^8.21.0"
	}
}
