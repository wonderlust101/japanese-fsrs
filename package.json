{
  "name": "japanese-fsrs",
  "packageManager": "bun@1.3.6",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "db:types": "supabase gen types typescript --project-id kukkptyopjdtuzgzamua > apps/api/src/db/database.types.ts"
  },
  "devDependencies": {
    "@fsrs-japanese/tsconfig": "workspace:*",
    "@types/bun": "^1.3.0",
    "eslint": "10.2.1",
    "supabase": "2.95.3",
    "typescript": "^5",
    "typescript-eslint": "8.59.0"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
