{
	"name": "@fsrs-japanese/web",
	"version": "0.0.0",
	"private": true,
	"//sideEffects": "Marks the package side-effect-free except CSS so webpack tree-shakes modules whose exports become unused after `process.env.NODE_ENV` gating (e.g. dev fixtures). globals.css is preserved by the glob; server-only is a server-side guard never in the client bundle.",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start --port 3000",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"analyze": "ANALYZE=true next build",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@fsrs-japanese/shared-types": "workspace:*",
		"@gsap/react": "^2.1.2",
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.104.1",
		"@tanstack/react-query": "^5.100.8",
		"gsap": "^3.15.0",
		"lenis": "^1.3.23",
		"next": "^15.3.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@fsrs-japanese/tsconfig": "workspace:*",
		"@next/bundle-analyzer": "^16.2.6",
		"@playwright/test": "^1.60.0",
		"@size-limit/file": "^12.1.0",
		"@tailwindcss/postcss": "^4.1.5",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest-axe": "^3.5.9",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.7",
		"jest-axe": "^10.0.0",
		"jsdom": "^29.1.1",
		"msw": "^2.14.6",
		"postcss": "^8",
		"size-limit": "^12.1.0",
		"tailwindcss": "^4.1.5",
		"typescript": "^5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.7"
	}
}
