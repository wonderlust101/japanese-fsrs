{
	"name": "@fsrs-japanese/api",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "bun --hot src/index.ts | pino-pretty",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"test": "bun test",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov src",
		"coverage:gate": "bun run scripts/coverage-gate.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"embeddings:backfill": "bun run scripts/backfill-premade-embeddings.ts",
		"premade:seed:generate": "bun run scripts/generate-premade-seed.ts",
		"seed:e2e": "bun run scripts/seed-e2e-user.ts"
	},
	"dependencies": {
		"@fsrs-japanese/shared-types": "workspace:*",
		"@supabase/supabase-js": "^2.104.1",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.37.0",
		"compression": "^1.7.5",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"openai": "^6.35.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"ts-fsrs": "^5.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@fsrs-japanese/tsconfig": "workspace:*",
		"@types/compression": "^1.7.5",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.0",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2"
	}
}
